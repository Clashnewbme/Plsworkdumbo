:root {
  --font-family: Tahoma, Verdana, Arial, sans-serif;
  --bg-panel: #293324;
  --bg-panel-solid: #293324;
  --border-panel: #7b806a;
  --border-focus: #d4c67a;
  --shadow-panel: 2px 2px 0 #11170f, inset 1px 1px 0 #515944;
  --color-gold: #d6bd59;
  --color-troops: #c7664c;
  --color-green: #80a65b;
  --color-blue: #829eaa;
}

* { box-sizing: border-box; }
html, body {
  margin: 0;
  height: 100%;
  overflow: hidden;
  background: #334538;
  font-family: var(--font-family);
  color: #e4dfc8;
  user-select: none;
  -webkit-user-select: none;
}

#c {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
}

button {
  background: #454c39;
  color: #e4dfc8;
  border: 1px solid #85846d;
  border-radius: 2px;
  box-shadow: inset 1px 1px 0 #666b52, inset -1px -1px 0 #252b20;
  padding: 7px 12px;
  cursor: pointer;
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  transition: background-color .1s ease;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}
button:hover:not(:disabled) {
  background: #62694e;
  color: #fff5cd;
  border-color: #c0b77e;
}
button:active:not(:disabled) {
  background: #353d2c;
  box-shadow: inset 1px 1px 2px #20261c;
}
button:focus-visible, input:focus-visible, select:focus-visible {
  outline: 2px solid #d4c67a;
  outline-offset: 2px;
}
button:disabled {
  opacity: .38;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

.top-controls {
  position: fixed;
  top: 14px;
  right: 14px;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-panel);
  padding: 6px 8px;
  border: 1px solid var(--border-panel);
  border-radius: 2px;
  box-shadow: var(--shadow-panel);
}
.ctrl-btn {
  padding: 6px 12px;
  font-size: 12.5px;
  font-weight: 600;
  border-radius: 2px;
  border: 1px solid #85846d;
  background: #454c39;
}
.ctrl-btn.active {
  background: #88773a;
  color: #fff2bd;
  border-color: #d1bd69;
  box-shadow: inset 1px 1px 0 #ae9a56, inset -1px -1px 0 #594d28;
}
.ctrl-leave {
  background: #603b32;
  border-color: #a56853;
  color: #f2c2a8;
}
.ctrl-leave:hover:not(:disabled) {
  background: #814637 !important;
  color: #fff0dc !important;
  border-color: #c58a68 !important;
  box-shadow: none !important;
}

#board {
  position: fixed;
  left: 14px;
  top: 14px;
  z-index: 10;
  min-width: 175px;
  max-width: 220px;
  background: var(--bg-panel);
  border: 1px solid var(--border-panel);
  border-radius: 2px;
  padding: 10px 14px;
  font-size: 12.5px;
  box-shadow: var(--shadow-panel);
}
.board-header {
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: #b9b397;
  margin-bottom: 6px;
  padding-bottom: 4px;
  border-bottom: 1px solid #646750;
}
.board-row {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 2.5px 0;
  color: #e1dcc4;
}
.board-color {
  display: inline-block;
  width: 8px;
  height: 8px;
  border-radius: 2px;
  flex-shrink: 0;
}
.board-name {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.board-tiles {
  font-weight: 600;
  color: #b9b397;
  font-variant-numeric: tabular-nums;
  margin-left: auto;
}

#hud {
  position: fixed;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 10;
  width: min(780px, calc(100vw - 28px));
  background: var(--bg-panel);
  border: 1px solid var(--border-panel);
  border-radius: 2px;
  padding: 12px 16px;
  box-shadow: var(--shadow-panel);
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.hud-stats-row {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.stats-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  justify-content: center;
}
.stat-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 2px;
  font-size: 13px;
  background: #353c2d;
  border: 1px solid #646750;
}
.stat-gold {
  background: #49432a;
  border-color: #817044;
}
.stat-gold .stat-val {
  color: #dfc966;
  font-size: 14px;
}
.stat-gold .stat-rate {
  color: #a5bb68;
  font-weight: 700;
  font-size: 12px;
}

.stat-troops {
  background: #4a332d;
  border-color: #805043;
}
.stat-troops .stat-val {
  color: #db8a68;
  font-size: 14px;
}
.stat-troops .stat-rate {
  color: #a5bb68;
  font-weight: 700;
  font-size: 12px;
}

.stat-land {
  background: #354044;
  border-color: #687d7c;
}
.stat-land .stat-val {
  color: #a8c1bd;
  font-size: 14px;
}

.stats-assets {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14px;
  font-size: 12px;
  color: #c7c2a9;
  padding-top: 2px;
}
.stat-asset {
  display: inline-flex;
  align-items: center;
  gap: 4px;
}
.stat-asset b {
  color: #e4dfc8;
}
.stat-sailing {
  color: #b2c6b0;
}

.hud-action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
}
.troop-slider-wrap {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 190px;
  background: #20271e;
  padding: 4px 10px;
  border-radius: 2px;
  border: 1px solid #555c48;
}
.slider-title {
  font-size: 12px;
  color: #c7c2a9;
  font-weight: 500;
  white-space: nowrap;
}
#pct {
  flex: 1;
  min-width: 60px;
  height: 5px;
  accent-color: #b7a65a;
  cursor: pointer;
}
#pctv {
  font-size: 12.5px;
  font-weight: 700;
  color: #d4c67a;
  min-width: 36px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

#btns {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  align-items: center;
}
.btn-build {
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 2px;
  background: #454c39;
  border: 1px solid #85846d;
}
.btn-build.on {
  background: #727747;
  color: #fff2bd;
  border-color: #d5cb91;
  font-weight: 700;
  box-shadow: inset 1px 1px 0 #9a9c60, inset -1px -1px 0 #42452e;
}
.btn-cancel {
  font-size: 12px;
  padding: 6px 10px;
  border-radius: 2px;
  background: #603b32;
  border: 1px solid #a56853;
  color: #f2c2a8;
}
.btn-cancel:hover:not(:disabled) {
  background: #814637;
  color: #fff0dc;
}

#help {
  text-align: center;
  font-size: 11.5px;
  color: #b9b397;
  letter-spacing: .01em;
}

.diplo-panel {
  position: fixed;
  right: 14px;
  bottom: 14px;
  z-index: 10;
  width: min(320px, calc(100vw - 28px));
  max-height: 380px;
  background: var(--bg-panel);
  border: 1px solid var(--border-panel);
  border-radius: 2px;
  box-shadow: var(--shadow-panel);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.diplo-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 9px 12px;
  background: #363d2e;
  border-bottom: 1px solid #646750;
}
.diplo-title-wrap {
  display: flex;
  align-items: center;
  gap: 6px;
}
.diplo-title {
  font-size: 12.5px;
  font-weight: 700;
  color: #e4dfc8;
}
.diplo-status-pill {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  padding: 2px 7px;
  border-radius: 2px;
  background: #455135;
  color: #c2d69a;
  border: 1px solid #748653;
}

.diplo-offer-box {
  padding: 10px 12px;
  background: #343f39;
  border-bottom: 1px solid #687d6e;
}
.diplo-offer-box[hidden] {
  display: none !important;
}
.offer-badge {
  display: inline-block;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .06em;
  color: #dfc966;
  background: #49432a;
  border: 1px solid #817044;
  padding: 2px 6px;
  border-radius: 4px;
  margin-bottom: 4px;
}
#offerTitle {
  margin: 0 0 4px 0;
  font-size: 13.5px;
  font-weight: 700;
  color: #f3edcf;
}
#offerText {
  margin: 0 0 8px 0;
  font-size: 12px;
  color: #c7c2a9;
  line-height: 1.4;
}
.offer-actions {
  display: flex;
  gap: 8px;
}
.btn-accept {
  flex: 1;
  background: #52653b;
  color: #e7edc8;
  border-color: #91a56d;
  font-weight: 700;
  padding: 5px 10px;
  font-size: 12px;
  border-radius: 2px;
}
.btn-accept:hover:not(:disabled) {
  background: #657b48;
  color: #fff;
  box-shadow: none;
}
.btn-reject {
  flex: 1;
  background: #603b32;
  color: #f2c2a8;
  border-color: #a56853;
  font-weight: 600;
  padding: 5px 10px;
  font-size: 12px;
  border-radius: 2px;
}
.btn-reject:hover:not(:disabled) {
  background: #814637;
  color: #fff0dc;
}

.diplo-feed {
  overflow-y: auto;
  max-height: 220px;
  padding: 8px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.diplo-feed::-webkit-scrollbar {
  width: 5px;
}
.diplo-feed::-webkit-scrollbar-thumb {
  background: #777864;
  border-radius: 3px;
}
.diplo-placeholder {
  font-size: 11.5px;
  color: #a49f86;
  text-align: center;
  padding: 12px 6px;
  font-style: italic;
  line-height: 1.4;
}
.diplo-item {
  padding: 6px 8px;
  border-radius: 2px;
  background: #353c2d;
  border-left: 3px solid #777864;
  font-size: 11.5px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}
.diplo-item.tag-request {
  border-left-color: #829eaa;
  background: #343f3e;
}
.diplo-item.tag-success {
  border-left-color: #80a65b;
  background: #384332;
}
.diplo-item.tag-danger {
  border-left-color: #c7664c;
  background: #46342e;
}
.diplo-item.tag-warning {
  border-left-color: #d6bd59;
  background: #45402d;
}
.diplo-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #b9b397;
  font-size: 10px;
}
.diplo-item-body {
  display: flex;
  align-items: center;
  gap: 5px;
  color: #e1dcc4;
  line-height: 1.35;
}
.diplo-color {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}
.diplo-text {
  flex: 1;
}

#toast {
  position: fixed;
  z-index: 100;
  left: 50%;
  top: 18px;
  transform: translate(-50%, -14px);
  padding: 8px 16px;
  border: 1px solid #85846d;
  background: #293324;
  border-radius: 2px;
  font-size: 13px;
  font-weight: 500;
  color: #e4dfc8;
  box-shadow: var(--shadow-panel);
  opacity: 0;
  pointer-events: none;
  transition: opacity .18s ease, transform .18s ease;
}
#toast.show {
  opacity: 1;
  transform: translate(-50%, 0);
}

#ctxMenu {
  position: fixed;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 175px;
  padding: 10px;
  background: #293324;
  border: 1px solid var(--border-panel);
  border-radius: 2px;
  box-shadow: var(--shadow-panel);
}
#ctxMenu[hidden] { display: none; }
#ctxMenu b { font-size: 13px; color: #f3edcf; }
#ctxMenu small { opacity: .85; margin-bottom: 6px; font-size: 11px; color: #b9b397; }
#ctxMenu button { font-size: 12px; padding: 6px 10px; justify-content: flex-start; }

.fl {
  display: inline-block;
  width: 14px;
  height: 9px;
  margin-right: 4px;
  border: 1px solid rgba(255, 255, 255, 0.3);
  vertical-align: middle;
}

#msg {
  position: fixed;
  z-index: 120;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: #293324;
  border: 2px solid #85846d;
  border-radius: 2px;
  padding: 30px 44px;
  text-align: center;
  font-size: 28px;
  font-weight: 700;
  box-shadow: 4px 4px 0 rgba(0, 0, 0, 0.55), inset 1px 1px 0 #515944;
}
#msg button {
  margin-top: 14px;
  padding: 10px 20px;
  font-size: 15px;
  background: #727747;
  color: #fff2bd;
  border-radius: 2px;
}
#msg small { font-size: 16px; color: #dfc966; font-weight: 500; }

#menu {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: grid;
  place-items: stretch;
  padding: 0;
  background: rgba(13, 19, 13, 0.78);
}
#menu[hidden] { display: none; }
#menuCard {
  width: 100%;
  height: 100%;
  max-height: 100%;
  overflow: auto;
  padding: clamp(24px, 5vw, 64px);
  border: 0;
  background: #293324;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
#menuCard > * {
  width: min(100%, 1060px);
  margin-left: auto;
  margin-right: auto;
}
.eyebrow {
  margin: 0;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .2em;
  color: #d4c67a;
  text-transform: uppercase;
}
#menu h1 {
  margin-top: 6px;
  margin-bottom: 8px;
  font-size: clamp(38px, 7vw, 70px);
  line-height: 1.05;
  letter-spacing: -.02em;
}
#menuCard > p:not(.eyebrow):not(.menu-tip) {
  color: #c7c2a9;
  line-height: 1.6;
}
.how-to {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-top: 20px;
  margin-bottom: 22px;
  color: #e1dcc4;
  font-size: 14px;
}
.how-to span {
  padding: 12px 14px;
  background: #353c2d;
  border: 1px solid #646750;
  border-radius: 2px;
}
.how-to b {
  display: inline-grid;
  place-items: center;
  width: 28px;
  height: 28px;
  margin-right: 8px;
  border: 1px solid #b9aa65;
  border-radius: 2px;
  font-size: 12px;
  color: #d4c67a;
}
.options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px 24px;
  margin-bottom: 24px;
}
.options label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-width: 0;
  font-size: 13.5px;
  color: #c7c2a9;
}
.options input, .options select {
  width: min(52%, 280px);
  min-width: 110px;
  padding: 8px 12px;
  background: #20271e;
  color: #f3edcf;
  border: 1px solid #777864;
  border-radius: 2px;
  font: inherit;
  font-size: 13px;
}
.options input:focus, .options select:focus {
  border-color: #d4c67a;
}
.options input[type=color] {
  height: 36px;
  padding: 3px;
  cursor: pointer;
}
.menu-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.menu-actions button {
  padding: 11px 22px;
  font-size: 14px;
  border-radius: 2px;
}
#menuStart, #menuNew {
  background: #727747;
  color: #fff2bd;
  font-weight: 700;
}
#menuStart:hover:not(:disabled), #menuNew:hover:not(:disabled) {
  background: #88773a;
  color: #fff2bd;
  box-shadow: none;
}
.menu-tip {
  margin: 16px 0 0;
  color: #a49f86;
  font-size: 12px;
}

#shop {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(13, 19, 13, 0.8);
}
#shop[hidden] { display: none; }
#shopCard {
  width: min(660px, 100%);
  max-height: 90vh;
  overflow: auto;
  padding: 24px;
  border: 1px solid var(--border-panel);
  border-radius: 2px;
  background: var(--bg-panel-solid);
  box-shadow: var(--shadow-panel);
}
#shopCard h2 { margin: 0; font-size: 22px; }
#shopTabs { display: flex; gap: 6px; flex-wrap: wrap; margin: 14px 0; }
#shopGrid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 10px;
  margin-bottom: 16px;
}
.item {
  display: flex;
  flex-direction: column;
  gap: 6px;
  align-items: stretch;
  padding: 8px;
  border: 1px solid #646750;
  border-radius: 2px;
  background: #353c2d;
  font-size: 12.5px;
}
.swatch {
  height: 36px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255, 255, 255, 0.25);
  border-radius: 4px;
  background-color: #1e293b;
}

@media (max-width: 1200px) {
  #hud {
    width: min(680px, calc(100vw - 360px));
    left: calc(50% - 80px);
  }
}

@media (max-width: 900px) {
  #board {
    min-width: 140px;
    font-size: 11.5px;
    padding: 8px 10px;
  }
  .top-controls {
    top: 10px;
    right: 10px;
    padding: 4px 6px;
  }
  .ctrl-btn {
    padding: 5px 9px;
    font-size: 11.5px;
  }
  #hud {
    left: 50%;
    transform: translateX(-50%);
    width: calc(100vw - 20px);
    bottom: 10px;
    padding: 10px 12px;
  }
  .diplo-panel {
    right: 10px;
    bottom: auto;
    top: 56px;
    max-height: 240px;
    width: min(280px, calc(100vw - 20px));
  }
}

@media (max-width: 640px) {
  #board {
    display: none;
  }
  .how-to { grid-template-columns: 1fr; gap: 8px; margin: 14px auto; }
  .options { grid-template-columns: 1fr; gap: 10px; }
  .options label { font-size: 13px; }
  .options input, .options select { width: 50%; min-width: 100px; padding: 6px; }
  #btns button { padding: 5px 7px; font-size: 11px; }
  .stats-assets { gap: 8px; font-size: 11px; }
  .stat-pill { padding: 3px 8px; font-size: 11.5px; }
}
